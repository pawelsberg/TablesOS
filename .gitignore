# Rust build output. Large, machine-specific, and embeds absolute paths
# (e.g. C:\Users\<you>\.cargo\registry\...) — never publish it.
/target
**/*.rs.bk

# Built bootable image (regenerated by `cargo run`); carries a per-build
# random system GUID and is multi-MB.
*.img

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
